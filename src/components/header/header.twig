            >
              Events
            </a>
            <ul class="dropdown-menu" aria-labelledby="events">
              <li><a class="dropdown-item" href="#">event 1</a></li>
              <li><a class="dropdown-item" href="#">event 2</a></li>
              <li>
                <a class="dropdown-item" href="#">event 3 </a>
              </li>
            </ul>
          </li>
          <li class="nav-item dropdown">
