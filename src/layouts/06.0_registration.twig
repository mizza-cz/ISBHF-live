{% extends "@components/base/base.twig" %} {% set title = "06.0_registration" %}
{% block main %}

<div class="bg-registration min-height-screen">
  {% include "@components/header/header.twig" %}
  <main class="main" aria-label="Hlavní obsah">
    <section class="pt-lg-16 pt-10 pb-lg-20 pb-10">
      <div class="container">
        <div class="position-relative">
          <div class="text-center mb-6">
            <h1 class="h2 text-light mb-4 titleDecore">
              Create your ISBHF account
            </h1>
            <p class="text-gray-300 text-md mx-auto" style="max-width: 416px">
              Register to watch live matches, access replays, and follow
              international ball hockey events.
            </p>
          </div>
          <div class="registration">
            <div class="container-xxs">
              <div class="d-flex flex-column gap-2">
                <a
                  href="/auth/apple"
                  type="button"
                  class="registration__social"
                >
                  <img
                    class="object-fit-contain"
                    src="images/ico/apple.svg"
                    width="20"
                    height="20"
                    alt="apple"
                  />
                  <span>Sign up with Apple</span>
                </a>

                <a
                  href="/auth/google"
                  type="button"
                  class="registration__social"
                >
                  <img
                    class="object-fit-contain"
                    src="images/ico/google.svg"
                    width="20"
                    height="20"
                    alt="apple"
                  />
                  <span>Sign up with Google</span>
                </a>
              </div>
              <div class="registration__divider">
                <span>or</span>
              </div>
              <form
                action="/customer/registration"
                method="post"
                id="frm-registrationForm"
                class="form"
              >
                <div class="d-flex flex-column gap-2">
                  <div class="form-box">
                    <label
                      for="frm-registrationForm-firstname"
                      class="form-label"
                      >First name</label
                    >
                    <input
                      type="text"
                      name="firstname"
                      placeholder="First name*"
                      class="form-control"
                      id="frm-registrationForm-firstname"
                      required
                      data-nette-rules='[{"op":":filled","msg":"This filed is mandatory."}]'
                      autofocus
                      autocomplete="given-name"
                    />
                  </div>

                  <div class="form-box">
                    <label
                      for="frm-registrationForm-lastname"
                      class="form-label"
                      >Last name</label
                    >
                    <input
                      type="text"
                      name="lastname"
                      placeholder="Last name*"
                      class="form-control"
                      id="frm-registrationForm-lastname"
                      required
                      data-nette-rules='[{"op":":filled","msg":"This filed is mandatory."}]'
                      autocomplete="family-name"
                    />
                  </div>

                  <div class="form-box">
                    <label
                      for="frm-registrationForm-postcode"
                      class="form-label"
                      >ZIP code</label
                    >
                    <input
                      type="text"
                      name="postcode"
                      placeholder="Post code"
                      class="form-control"
                      id="frm-registrationForm-postcode"
                    />
                  </div>

                  <div class="form-box form-box--select">
                    <label for="frm-registrationForm-country" class="form-label"
                      >Country of residence</label
                    >
                    <select
                      name="country"
                      class="js-select"
                      id="frm-registrationForm-country"
                    >
                      <option value="">Select country</option>
                      <option value="CZ">Czech Republic</option>
                      <option value="SK">Slovakia</option>
                      <option value="DE">Germany</option>
                      <option value="AT">Austria</option>
                      <option value="PL">Poland</option>
                      <option value="US">United States</option>
                      <option value="GB">United Kingdom</option>
                      <!-- doplnit kompletní číselník zemí světa -->
                    </select>
                  </div>
                  <div class="form-box">
                    <label for="frm-registrationForm-email" class="form-label"
                      >E-mail</label
                    >
                    <input
                      type="email"
                      name="email"
                      placeholder="E-mail*"
                      class="form-control"
                      id="frm-registrationForm-email"
                      required
                      data-nette-rules='[{"op":":filled","msg":"This filed is mandatory."},{"op":":email","msg":"Please enter valid email address."},{"op":":email","msg":"Enter valid e-mail address."}]'
                    />
                  </div>

                  <div class="form-box">
                    <label
                      for="frm-registrationForm-password"
                      class="form-label"
                      >Password</label
                    >
                    <div class="form__pass">
                      <input
                        type="password"
                        name="password"
                        placeholder="Password*"
                        class="form-control"
                        id="frm-registrationForm-password"
                        required
                        data-nette-rules='[{"op":":filled","msg":"This filed is mandatory."},{"op":":minLength","msg":"Password must have at least 8 characters.","arg":8}]'
                      />
                      <button type="button" class="form__pass-toggle">
                        <span class="icon-show">
                          <img src="/img/front/ico/eye-hidden.svg" alt="" />
                        </span>
                        <span class="icon-hide">
                          <img src="/img/front/ico/eye-visible.svg" alt="" />
                        </span>
                      </button>
                    </div>
                  </div>

                  <div class="form-box">
                    <label
                      for="frm-registrationForm-passwordRepeat"
                      class="form-label"
                      >Repeat password</label
                    >
                    <input
                      type="password"
                      name="passwordRepeat"
                      placeholder="Repeat password*"
                      class="form-control"
                      id="frm-registrationForm-passwordRepeat"
                      required
                      data-nette-rules='[{"op":":filled","msg":"This filed is mandatory."},{"op":":minLength","msg":"Password must have at least 8 characters.","arg":8}]'
                    />
                  </div>
                </div>
                <label class="form-checkbox">
                  <input
                    class="form-checkbox__input"
                    type="checkbox"
                    required
                  />

                  <span class="form-checkbox__box"></span>

                  <span class="form-checkbox__text">
                    I agree to the
                    <a
                      href="/simple-page/detail/isbhf-tv-terms-conditions-1"
                      target="_blank"
                      >Terms and Conditions</a
                    >
                    and the
                    <a
                      href="/simple-page/detail/isbhf-tv-privacy-notice-8"
                      target="_blank"
                      >Privacy Policy / GDPR information.</a
                    >
                  </span>
                </label>

                <button
                  type="submit"
                  name="save"
                  class="btn btn-primary text-dark form-submit"
                >
                  Create account
                </button>
                <input
                  type="hidden"
                  name="_token_"
                  value="iwnlntmqocjRl2UGIKzvZ7lZGgVJBw4JQgpnc="
                /><input
                  type="submit"
                  name="_ajaxOnChange"
                  data-ajax-validate='{"form":false}'
                  class="ajax d-none"
                  value=""
                /><input
                  type="hidden"
                  name="_do"
                  value="registrationForm-submit"
                />
              </form>
              <div class="text-md text-center text-gray-300 mt-lg-12 mt-8">
                Already have an account?
                <a href="#" class="d-block text-accent underline">Log in</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>

{% include "@components/modalPromo/modalPromo.twig"%} {% endblock %}
